# ============================================================
# RAG PDF Chatbot Configuration (.env.example)
# ============================================================

# LLM Provider Configuration ("gemini", "openai", "ollama")
LLM_PROVIDER=gemini

# Google Gemini Settings (Verified active models: gemini-3.8-flash, gemini-3.5-flash)
# Note: gemini-2.0-flash and gemini-1.5-flash are retired/shut down.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.0

# Optional: OpenAI Settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embeddings Provider ("local" or "gemini")
# "local" runs sentence-transformers on CPU for $0 cost
# "gemini" uses models/gemini-embedding-001 (text-embedding-004 is retired)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
HISTORY_WINDOW_MESSAGES=6

# Relevance Score Threshold (0.0 to 1.0)
# Uses Cosine Similarity: similarity = 1 - distance
# Chunks with similarity lower than this threshold are rejected.
# If no chunk meets this threshold, the system immediately returns
# "I could not find information about that..." without calling the LLM.
# Calibrate this value using tests/sample_eval.py output.
RELEVANCE_THRESHOLD=0.34

# Security & Upload Controls
MAX_FILE_SIZE_MB=20

# Storage Paths
CHROMA_PERSIST_DIR=./data/chroma_db
